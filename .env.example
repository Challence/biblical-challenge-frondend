# ============================================================
# PUBLIC CONFIGURATION — safe as GitHub Actions Variables
# ============================================================

# Supabase project identifier (GitHub Actions only)
SUPABASE_PROJECT_REF=

# Supabase public API configuration (local and GitHub Actions)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Generate with: pnpm dlx web-push generate-vapid-keys
# This public key is safe to expose to the browser.
VAPID_PUBLIC_KEY=

# Public contact and comma-separated browser origins
VAPID_SUBJECT=
APP_ORIGINS=

# Vercel project identifiers (GitHub Actions only; not credentials)
VERCEL_PROJECT_ID=
VERCEL_ORG_ID=

# ============================================================
# SECRETS — GitHub Actions Secrets; never commit real values
# ============================================================

# Generated together with VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=

# Generate with: openssl rand -base64 48
PUSH_CRON_SECRET=

# Scoped Supabase personal access token used by CI. Required permissions:
# project_admin_read, api_gateway_keys_read, api_gateway_keys_secret_read,
# database_pooling_config_read, database_write, Edge Functions read-write,
# and Edge Function Secrets read-write.
SUPABASE_ACCESS_TOKEN=

# Vercel deployment token created in Account Settings > Tokens
VERCEL_TOKEN=

# ============================================================
# AUTOMATIC ALIASES — do not provide duplicate values
# ============================================================

# The GitHub Actions workflow must create these aliases for the Vite build:
# VITE_SUPABASE_URL=${SUPABASE_URL}
# VITE_SUPABASE_PUBLISHABLE_KEY=${SUPABASE_PUBLISHABLE_KEY}
# VITE_VAPID_PUBLIC_KEY=${VAPID_PUBLIC_KEY}
#
# Never expose VAPID_PRIVATE_KEY or PUSH_CRON_SECRET through VITE_ variables.
# Supabase provides SUPABASE_SERVICE_ROLE_KEY automatically to Edge Functions.
